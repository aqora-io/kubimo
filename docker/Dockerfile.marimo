# syntax=docker/dockerfile:1.17

FROM scratch AS nodejs-arm64
ARG NODE_VERSION=24.11.1
ARG NODE_CHKSUM=sha256:0dc93ec5c798b0d347f068db6d205d03dea9a71765e6a53922b682b91265d71f
ADD --checksum=${NODE_CHKSUM} https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.gz /mnt/node.tar.gz

FROM scratch AS nodejs-amd64
ARG NODE_VERSION=24.11.1
ARG NODE_CHKSUM=sha256:58a5ff5cc8f2200e458bea22e329d5c1994aa1b111d499ca46ec2411d58239ca
ADD --checksum=${NODE_CHKSUM} https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz /mnt/node.tar.gz

FROM nodejs-${TARGETARCH} AS nodejs

# download pixi
FROM scratch AS pixi-arm64
ARG PIXI_VERSION=v0.81.0
ARG PIXI_CHKSUM=sha256:7fcd20f7c18339f13552a6767ab146ce6b439ce29db46cc03ece005ca9696bb1
ADD --checksum=${PIXI_CHKSUM} --chmod=u=rwx,go=rx https://github.com/prefix-dev/pixi/releases/download/${PIXI_VERSION}/pixi-aarch64-unknown-linux-musl /mnt/pixi

FROM scratch AS pixi-amd64
ARG PIXI_VERSION=v0.81.0
ARG PIXI_CHKSUM=sha256:248510f5f75460a2ae4ec62d761e15c0191dc35db3b1da6f82d9f17c6017051d
ADD --checksum=${PIXI_CHKSUM} --chmod=u=rwx,go=rx https://github.com/prefix-dev/pixi/releases/download/${PIXI_VERSION}/pixi-x86_64-unknown-linux-musl /mnt/pixi

FROM pixi-${TARGETARCH} AS pixi-release

# marimo source, in a stage of its own so a local checkout can replace it:
# docker buildx bake marimo --allow=fs.read=<dir> --set marimo.contexts.marimo-src=<dir>
FROM scratch AS marimo-src
ARG MARIMO_GIT=https://github.com/aqora-io/marimo.git#562cdeb4d32987c62eb4e3f65e57d3339f1dd060
ADD ${MARIMO_GIT} /

# build marimo
FROM ghcr.io/astral-sh/uv:0.12.19-python3.12-trixie-slim AS build-marimo
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
<<EOF
apt-get update
apt-get install -y --no-install-recommends make
EOF

RUN --mount=from=nodejs,src=/mnt,dst=/mnt \
<<EOF
  tar xf /mnt/node.tar.gz -C /usr/local --strip-components 1 --wildcards '*/bin' '*/share' '*/lib' '*/include'
  corepack enable
EOF

COPY --from=marimo-src / /build/
WORKDIR /build
RUN \
  --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
  --mount=type=cache,target=/build/node_modules,sharing=locked \
  --mount=type=cache,target=/root/.cache/uv,sharing=locked \
  --mount=type=cache,target=/root/.local/share/uv/python,sharing=locked \
  --mount=type=cache,target=/build/.venv,sharing=locked \
<<EOF
  pnpm install --frozen-lockfile
  uv sync --locked
  make fe
  make -C packages/ssr
  uv build --wheel
EOF

# pixi's generic name for each architecture, pinned for the seeded
# environment's sake (see CONDA_OVERRIDE_LINUX below)
FROM ghcr.io/astral-sh/uv:0.12.19-python3.12-trixie-slim AS base-amd64
ENV CONDA_OVERRIDE_ARCHSPEC=x86_64

FROM ghcr.io/astral-sh/uv:0.12.19-python3.12-trixie-slim AS base-arm64
ENV CONDA_OVERRIDE_ARCHSPEC=aarch64

# actual image deployed to production
FROM base-${TARGETARCH} AS marimo
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]
ARG USER=me

RUN <<EOF
useradd -m -s /bin/bash -u 1000 ${USER}
mkdir /home/${USER}/workspace
chown 1000:1000 /home/${USER}/workspace
EOF

RUN --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
<<EOF
apt-get update
# graphviz puts `dot` on every kernel's PATH, which the graphviz Python
# package shells out to when it renders.
apt-get install -y --no-install-recommends \
  build-essential cmake curl git graphviz xz-utils \
EOF

COPY --from=pixi-release /mnt/pixi /usr/local/bin/pixi
COPY --from=build-marimo /build/dist/ /opt/marimo/dist/

RUN \
  --mount=type=cache,dst=/root/.cache/uv,sharing=locked \
  --mount=type=bind,source=docker/setup/system-requirements.txt,target=/mnt/system-requirements.txt \
<<EOF
marimo_whl=`find /opt/marimo/dist -name 'marimo-*.whl'`
# Installed into the *system* interpreter, which serves marimo. Kernels run in
# their notebook's own pixi environment, built from its PEP 723 header, with
# this same wheel overlaid on top (see MARIMO_RUNTIME_WHEEL below), so server
# and kernels are one build of the fork. Only a notebook without a header,
# served by `marimo run` or cached by cache.py, runs on this interpreter.
#
# The extra requirements serve the server and its terminal (the aqora CLI,
# formatters, the file watcher, exports); kubimo_migrate.py reads the same file
# when it declares what legacy kernels imported from here.
uv pip install --system \
  "marimo[recommended,lsp] @ file://${marimo_whl}" \
  -r /mnt/system-requirements.txt
# Bytecode for this interpreter's whole library, the standard library
# included: the base image ships none, and me cannot write any here at
# runtime, so every process on it (marimo itself, a header-less notebook's
# kernel, cache.py) otherwise compiles everything it imports on every start,
# about 3 s of marimo's own.
/usr/local/bin/python3 -m compileall -q -j0 \
  "$(/usr/local/bin/python3 -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')"
EOF

RUN --mount=from=nodejs,src=/mnt,dst=/mnt/nodejs \
    --mount=from=build-marimo,src=/build/packages/ssr,dst=/mnt/marimo \
    --mount=type=cache,target=/root/.npm,sharing=locked \
<<EOF
  tar xf /mnt/nodejs/node.tar.gz -C /usr/local --strip-components 1 --wildcards '*/bin' '*/share' '*/lib' '*/include'
  npm install -g /mnt/marimo/npm.tgz
  corepack enable
EOF

COPY --chown=root --chmod=u=rwx,go=rx docker/setup/kubimo-uv /usr/local/bin/kubimo-uv

# The fork overlays itself into every kernel from its own wheel, through
# kubimo-uv (uv, offline first) instead of a uv fetched through `pixi exec`,
# and new notebooks' headers require the Python the caches below are seeded
# for. The uv backend runs kubimo-uv for everything too, package operations
# inside kernels included (MARIMO_UV: uv resets UV in the processes it runs).
# The caches live under /home/me, the node template each new slot is copied
# from, so what the seed downloads reaches every slot. UV_TOOL_BIN_DIR is
# blanked: the base image points it at /usr/local/bin, which me cannot write.
ENV MARIMO_RUNTIME_WHEEL=/opt/marimo/dist \
    MARIMO_PIXI_UV=/usr/local/bin/kubimo-uv \
    MARIMO_UV=/usr/local/bin/kubimo-uv \
    MARIMO_DEFAULT_REQUIRES_PYTHON="==3.12.*" \
    PIXI_CACHE_DIR=/home/${USER}/.cache/rattler/cache \
    UV_CACHE_DIR=/home/${USER}/.cache/uv \
    UV_TOOL_BIN_DIR=

# pixi keys each environment it solves, the seeded one below included, on the
# machine's virtual packages, and the nodes are not the build machine: their
# CPUs may differ, and gVisor reports kernel 4.19 whatever the node runs. So
# the seed and every process on every node pin the same ones: the generic
# architecture (set per architecture above) and kernel 4.19, which newer
# kernels stay compatible with. glibc is the image's own everywhere.
ENV CONDA_OVERRIDE_LINUX=4.19

USER ${USER}
WORKDIR /home/${USER}/workspace

# Seed the node template with the environment of the canonical notebook, the
# readme.py every workspace starts with, and the packages marimo overlays on
# it, so its first kernel starts without the network: the pixi environment is
# reused as it is, and kubimo-uv builds the overlay offline from the cached
# packages. Planned by marimo itself so the cache keys match a real kernel
# launch; no cache mounts, so the result lands in this layer. The seeded
# overlay and the wheel's own cache entries are dropped: uv keys them on the
# wheel's ctime, which unpacking the image changes, so no slot could reuse
# them; the agent rebuilds them once per node while it stages the template
# (docker/app/kubimo_prebuild_overlay.py). The uv backend's environment of the
# same notebook is synced after that cleanup, so it and the PyPI marimo its
# manifest names stay cached and a new uv notebook resolves offline too; it is
# not launched, as its overlay is keyed on the same ctime. The workspace
# itself must stay empty: the agent hydrates it from S3.
RUN --mount=type=bind,source=docker/setup/seed-notebook.py,target=/mnt/seed-notebook.py \
<<EOF
cp /mnt/seed-notebook.py readme.py
/usr/local/bin/python3 - <<'PY'
import asyncio, subprocess
from marimo._environments import backends
from marimo._environments.overlay import runtime_overlay
nb = "/home/me/workspace/readme.py"
env = asyncio.run(backends.sync_notebook_async(nb, backend="pixi"))
plan = backends.launch(env, ["-c", "import marimo, zmq, msgspec"], backend="pixi", overlay=runtime_overlay())
subprocess.run(list(plan.argv), env=dict(plan.env), check=True)
PY
for env in /home/${USER}/.cache/uv/environments-v2/*/*; do
  rm -r "$(readlink -f "$env")"
done
rm -r /home/${USER}/.cache/uv/environments-v2
uv cache clean marimo
/usr/local/bin/python3 - <<'PY'
import asyncio
from marimo._environments import backends
asyncio.run(backends.sync_notebook_async("/home/me/workspace/readme.py", backend="uv"))
PY
rm readme.py
du -shc /home/${USER}/.cache/*
find /home/${USER}/.cache | wc -l
EOF

COPY docker/setup /setup
COPY docker/app /app

# Runs the whole docker/app suite against the real image. Its `image` tests
# prove the sandbox contract with the real pixi, uv, network and the fork wheel
# above, not a stub; the others run the image's own scripts on the fork, so a
# fork bump that moves an API they use fails here too. Never shipped -- the
# marimo-test bake target only ever builds this stage, with cacheonly output.
FROM marimo AS test
USER root
RUN uv pip install --system pytest
USER me
# -p no:cacheprovider: /app is root-owned (COPY above, unchanged for the
# shipped image), so me cannot write .pytest_cache there, and a one-shot
# build has no later run to reuse it anyway.
RUN pytest -q -p no:cacheprovider /app
