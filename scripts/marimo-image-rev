#!/bin/sh
# Resolve the git revision that defines the marimo image's contents.
#
# The marimo image is tagged by its own source (`src-<rev>`) rather than by the release
# version, for the same reason the agent image is — see scripts/agent-image-rev — but
# with a wider blast radius. This one image is referenced twice:
#
#   * runners are started from it, so moving the tag recreates every runner pod, and
#   * the agent stages its venv template from it, so moving the tag rolls the agent
#     DaemonSet, which destroys each node's data volume and re-hydrates every slot on it.
#
# Tagging it by the release version meant a controller-only release did both. The agent's
# own `src-` tag did not prevent it: the tag protects the agent *container*, while the
# venv-template initContainer still followed the chart appVersion.
#
# The path list is every input that ends up in the image: the Dockerfile, the files baked
# into it, and the bake file that pins the marimo fork. The image ships no Rust — the
# workspace crates feed the agent and controller images only. As with the agent, err
# toward including — over-including costs an unnecessary roll, under-including ships a
# stale image against a newer controller, and only the second is dangerous.
# docker-bake.hcl is included whole for that reason, though only its MARIMO_GIT variable
# feeds this image.
#
# This is a content hash rather than a git revision on purpose, for exactly the reasons
# agent-image-rev explains.
#
#   marimo-image-rev            print the hash
#   marimo-image-rev --check    verify the path list still covers the image
set -eu
cd -- "$(dirname -- "$0")/.."

MARIMO_PATHS="docker/Dockerfile.marimo docker/setup docker/app docker-bake.hcl"

check() {
    dockerfile=docker/Dockerfile.marimo
    if ! [ -f "$dockerfile" ]; then
        echo "error: $dockerfile not found — did it move? Update MARIMO_PATHS and this check." >&2
        return 1
    fi
    # Every build-context path the image consumes must be under MARIMO_PATHS, or a
    # change to it would alter the image without moving its tag. Context paths enter
    # via COPY/ADD sources (stage copies with --from= and checksum-pinned URL/git
    # sources don't read the context; ARG-valued sources are pinned by the Dockerfile
    # and docker-bake.hcl, both hashed) and via RUN bind mounts without a from= stage.
    uncovered=$(awk -v paths="$MARIMO_PATHS" '
        BEGIN { n = split(paths, allow, " ") }
        function covered(p,  i) {
            for (i = 1; i <= n; i++)
                if (p == allow[i] || index(p, allow[i] "/") == 1) return 1
            return 0
        }
        {
            for (i = 1; i <= NF; i++) {
                # Bind is the default mount type, so only an explicit other
                # type or a from= stage rules a mount out.
                if ($i !~ /^--mount=/ || $i ~ /from=/) continue
                if ($i ~ /[=,]type=/ && $i !~ /[=,]type=bind(,|$)/) continue
                # The context path is source= (or src=); omitted means the
                # context root, which no path list covers.
                if (match($i, /[=,](source|src)=[^,]*/)) {
                    src = substr($i, RSTART, RLENGTH)
                    sub(/^[=,](source|src)=/, "", src)
                    if (!covered(src)) print FNR ": " $i
                } else
                    print FNR ": " $i " (bind-mounts the build context root)"
            }
        }
        toupper($1) == "COPY" || toupper($1) == "ADD" {
            if ($0 ~ /--from=/) next
            for (i = 2; i < NF; i++) {
                if ($i ~ /^--/) continue
                if ($i ~ /^[a-z+.-]+:\/\//) continue
                if ($i ~ /^\$\{?[A-Za-z_]/) continue
                if (!covered($i)) print FNR ": " $i
            }
        }
    ' "$dockerfile")
    if [ -n "$uncovered" ]; then
        echo "error: $dockerfile consumes context paths MARIMO_PATHS does not cover:" >&2
        echo "$uncovered" | sed 's/^/       line /' >&2
        echo "       Add them to MARIMO_PATHS, or the marimo image will not be rebuilt" >&2
        echo "       when they change." >&2
        return 1
    fi
    echo "marimo image path list is consistent"
}

rev() {
    {
        git ls-files -- $MARIMO_PATHS | sort | while IFS= read -r file; do
            # Name as well as content, so a rename or deletion moves the hash.
            echo "$file"
            cat "$file"
        done
    } | sha256sum | cut -c1-16
}

case "${1:-}" in
    --check) check ;;
    "") rev ;;
    *) echo "usage: $0 [--check]" >&2; exit 2 ;;
esac
